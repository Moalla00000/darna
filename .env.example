# Darna environment configuration
# Copy this file to `.env` and fill in real values for your local setup.
# `.env` is ignored by Git — never commit real credentials.

# ESP32 door controller base URL on your home Wi-Fi network.
# Pass to the Flutter build via: flutter run --dart-define=ESP32_BASE_URL=http://192.168.1.200
ESP32_BASE_URL=http://192.168.1.200

# ESP32 Wi-Fi credentials belong in backend/include/secrets.h (gitignored),
# not here. These are shown only as placeholders:
# WIFI_SSID=your_network_ssid
# WIFI_PASSWORD=your_wifi_password
