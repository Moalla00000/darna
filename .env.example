# Darna app environment configuration
#
# Copy this file to `frontend/.env` before building or running the app:
#
#   cp .env.example frontend/.env
#
# The Flutter app bundles this file as an asset and reads ESP32_BASE_URL at
# startup. `.env` is gitignored; never commit real credentials.
#
# This value must match LOCAL_IP in backend/include/secrets.h.
# Use http:// (not https://) and no trailing slash.
ESP32_BASE_URL=http://192.168.1.200

# 4-digit PIN required to unlock the door in the mobile application.
# Must be exactly 4 numeric digits. Each app session requires PIN
# authentication on first unlock attempt.
DOOR_PIN=1234
